@startuml
!theme plain

title Pipelines: Verify & Email — amail-md

actor "User" as user
participant "verify_markdown()" as verify
participant "markdown_to_email()" as email
participant "configurer" as cfg
participant "segmenter\nengine" as seg
participant "segmenter\nregistry" as seg_reg
participant "MarkdownParser\n(Port)" as parse
participant "GenericToken" as token
participant "LinterEngine" as lint_eng
participant "linter\nrules" as lint_rules
participant "renderer" as renderer
participant "MJML\nregistry" as mjml_reg
participant "MjmlCompiler\n(Port)" as compile

== Verify Flow ==

user -> verify : verify_markdown(source)
activate verify

verify -> seg : segment(source)
activate seg
seg -> parse : parse(source)
activate parse
parse -> parse : markdown-it-py → raw AST
parse -> token : convert to GenericToken
parse --> seg : list[GenericToken]
deactivate parse
seg -> seg_reg : dispatch(token.type)
activate seg_reg
seg_reg -> seg_reg : builders classify tokens
seg_reg --> seg : EmailStructure[]
deactivate seg_reg
seg --> verify : EmailStructure[]
deactivate seg

verify -> lint_eng : validate(email_structure)
activate lint_eng
lint_eng -> lint_rules : execute all rules
lint_rules --> lint_eng : errors[]
lint_eng --> verify : errors[]
deactivate lint_eng

verify --> user : errors[]
deactivate verify

== Email Flow ==

user -> email : markdown_to_email(source)
activate email

email -> cfg : configure(source)
activate cfg
cfg -> cfg : parse frontmatter, resolve theme
cfg --> email : Frontmatter + Theme
deactivate cfg

email -> seg : segment(source)
activate seg
seg -> parse : parse(source)
activate parse
parse -> parse : markdown-it-py → raw AST
parse -> token : convert to GenericToken
parse --> seg : list[GenericToken]
deactivate parse
seg -> seg_reg : dispatch(token.type)
activate seg_reg
seg_reg -> seg_reg : builders classify tokens
seg_reg --> seg : EmailStructure[]
deactivate seg_reg
seg --> email : EmailStructure[]
deactivate seg

email -> lint_eng : validate(email_structure)
activate lint_eng
lint_eng -> lint_rules : execute all rules (warnings only)
lint_rules --> lint_eng : warnings[]
lint_eng --> email : warnings[]
deactivate lint_eng

email -> renderer : render(email_structure, theme)
activate renderer
renderer -> mjml_reg : dispatch(model.type)
activate mjml_reg
mjml_reg -> mjml_reg : nodes render to MJML
mjml_reg --> renderer : MJML string
deactivate mjml_reg
renderer --> email : MJML
deactivate renderer

email -> compile : compile(mjml)
activate compile
compile -> compile : mrml (Rust) → HTML
compile --> email : HTML
deactivate compile

email --> user : RenderResult(html, text, meta, warnings)
deactivate email

@enduml
