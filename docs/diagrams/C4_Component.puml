@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Components of the amail-md library

Container_Boundary(amailmd, "amail-md") {

  Container_Boundary(api, "Public API") {
    Component(verify, "verify_markdown()", "entry point", "Validates markdown, returns errors")
    Component(email, "markdown_to_email()", "entry point", "Converts markdown to email-safe HTML")
  }

  Container_Boundary(core, "Core") {
    Component(orch, "orchestrator", "service", "Drives the pipeline, returns RenderResult")

    Container_Boundary(services, "Services") {
      Component(cfg, "configurer", "service", "Extracts, resolves, merges frontmatter + theme")
      Component(seg_engine, "segmenter engine", "service", "Walks AST, applies builders")
      Component(seg_registry, "segmenter registry", "registry", "Maps token types → builders")
      Component(lint_engine, "linter engine", "service", "Executes all active rules")
    }

    Container_Boundary(models, "Models") {
      Component(es_root, "EmailStructure", "abstract base", "Root contract for email pieces")
      Component(paragraph, "Paragraph", "model", "Plain text block")
      Component(heading, "Heading", "model", "Section标题 h1-h6")
      Component(button, "Button", "model", "CTA: href, text, variant")
    }

    Container_Boundary(ports, "Ports") {
      Component(p_parse, "MarkdownParser", "Protocol", "parse(md) → list[GenericToken]")
      Component(p_comp, "MjmlCompiler", "Protocol", "compile(mjml) → html")
      Component(p_token, "GenericToken", "dataclass", "Parser-agnostic token")
    }
  }

  Container_Boundary(infrastructure, "Infrastructure") {
    Container_Boundary(adapters, "Adapters") {
      Component(a_parse, "MarkdownItParser", "adapter", "markdown → GenericToken")
      Component(a_comp, "MrmlCompiler", "adapter", "MJML → HTML")
    }

    Container_Boundary(mjml, "MJML Adapter") {
      Component(mjml_registry, "registry", "registry", "Maps models → renderers")
      Component(mjml_nodes, "nodes", "renderers", "One file per model")
    }

    Container_Boundary(segmenter, "Segmenter Builders") {
      Component(builders, "builders", "builders", "One file per token type")
    }

    Container_Boundary(lint, "Linter Rules") {
      Component(rules, "rules", "rules", "One file per validation rule")
    }
  }
}

System_Ext(mdit, "markdown-it-py", "external lib")
System_Ext(mdit_plugins, "mdit-py-plugins", "attrs, container")
System_Ext(mrml, "mrml", "external lib")

Rel(verify, lint_engine, "uses")
Rel(verify, seg_engine, "uses")

Rel(email, orch, "calls")
Rel(orch, cfg, "uses")
Rel(orch, seg_engine, "uses")
Rel(orch, lint_engine, "uses")
Rel(orch, mjml_registry, "uses")

Rel(seg_engine, seg_registry, "uses")
Rel(seg_registry, builders, "dispatches")
Rel(builders, es_root, "creates")

Rel(lint_engine, rules, "executes")
Rel(rules, es_root, "validates")

Rel(mjml_registry, mjml_nodes, "dispatches")
Rel(mjml_nodes, es_root, "reads")

Rel(a_parse, p_parse, "implements")
Rel(a_comp, p_comp, "implements")
Rel(a_parse, mdit, "imports")
Rel(a_parse, mdit_plugins, "imports")
Rel(a_comp, mrml, "imports")

SHOW_LEGEND()
@enduml
