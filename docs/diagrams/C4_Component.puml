@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Components of the amail-md library

Container_Boundary(amailmd, "amail-md") {

  Container_Boundary(api, "Public API") {
    Component(verify, "verify_markdown()", "entry point", "Validates markdown, returns errors")
    Component(email, "markdown_to_email()", "entry point", "Converts markdown to email-safe HTML")
  }

  Container_Boundary(services, "Render Services") {
    Component(cfg, "configurer", "service", "Extracts, resolves, merges and sanitizes frontmatter + theme")
    Component(seg, "segmenter", "service", "Walks the markdown-it-py AST, classifies blocks → Email Structure")
    Component(renderer, "renderer", "service", "Assembles EmailStructure → MJML → HTML")
  }

  Container_Boundary(lint_b, "Linter") {
    Component(lint_engine, "LinterEngine", "service", "Validates Email Structure against email rules")
  }

  Container_Boundary(es, "Email Structure") {
    Component(es_root, "EmailStructure", "abstract base", "Root contract: to_mjml(theme) → str")
  }

  Container_Boundary(ports, "Ports") {
    Component(p_parse, "MarkdownParser", "Protocol", "parse(md) → Email Structure")
    Component(p_comp, "MjmlCompiler", "Protocol", "to_html(mjml) → html")
  }

  Container_Boundary(adapters, "Adapters") {
    Component(a_parse, "MarkdownItParser", "adapter", "markdown → Email Structure (uses markdown-it-py)")
    Component(a_comp, "MrmlCompiler", "adapter", "MJML → HTML (uses mrml)")
  }
}

System_Ext(mdit, "markdown-it-py", "external lib")
System_Ext(mrml, "mrml", "external lib")

Rel(verify, lint_engine, "uses")
Rel(verify, seg, "uses")

Rel(email, seg, "uses")
Rel(email, cfg, "uses")
Rel(email, renderer, "uses")

Rel(renderer, p_comp, "uses")
Rel(renderer, es_root, "uses")

Rel(lint_engine, es_root, "validates")

Rel(seg, es_root, "builds")
Rel(seg, p_parse, "uses")

Rel(p_parse, a_parse, "implemented by")
Rel(p_comp, a_comp, "implemented by")
Rel(a_parse, mdit, "imports")
Rel(a_comp, mrml, "imports")

SHOW_LEGEND()
@enduml
