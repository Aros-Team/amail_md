@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Containers of amail-md

Person(user, "User")

System_Boundary(amailmd, "amail-md") {

  Container(api, "Public API", "amail_md.__init__", "markdown_to_email(), verify_markdown()")

  Container(services, "Render Services", "core", "Segmenter + Renderer")

  Container(linter, "Linter", "core", "Validates Email Structure against email rules")

  Container(es, "Email Structure", "domain model", "Contract for email pieces")

  Container(ports, "Ports", "Protocol", "MarkdownParser, MjmlCompiler")
  Container(adapters, "Adapters", "Python", "MarkdownItParser, MrmlCompiler")
}

System_Ext(mdit, "markdown-it-py", "Markdown → AST")
System_Ext(mrml, "mrml", "MJML → HTML")
System_Ext(apps, "Sending Applications", "fill in {{variables}} and send")

Rel(user, api, "calls")
Rel(api, services, "uses")
Rel(api, linter, "uses")
Rel(services, ports, "uses")
Rel(linter, services, "uses")
Rel(services, es, "uses")
Rel(ports, adapters, "implemented by")
Rel(adapters, mdit, "imports")
Rel(adapters, mrml, "imports")
Rel(api, apps, "returns HTML + text")

SHOW_LEGEND()
@enduml
