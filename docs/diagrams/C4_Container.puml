@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Containers of amail-md

Person(author, "Content Author", "Writes Markdown")

System_Boundary(amailmd, "amail-md") {

  Container(render, "render()", "Python / API", "Orchestrator. Drives the pipeline and returns the result")

  Container(cfg, "Configuration", "service", "Parses Frontmatter, resolves Theme")
  Container(services, "Render Services", "core", "Configuration, Segmenter, Plaintext, RenderResult")
  Container(es, "Email Structure", "Python / dataclasses", "Structured email: Paragraph, Button, ColumnCell, Heading, …")
  Container(ports, "Ports", "Python / Protocol", "MarkdownParser, MjmlCompiler, Wrapper")
  Container(adapters, "Adapters", "Python", "MarkdownItParser, MrmlCompiler, DefaultWrapper")
}

System_Ext(mdit, "markdown-it-py", "Markdown → AST")
System_Ext(mrml, "mrml", "MJML → HTML")
System_Ext(apps, "Sending Applications", "fill in {{variables}} and send")

Rel(author, render, "calls")
Rel(render, services, "orchestrates")
Rel(render, es, "uses")
Rel(render, ports, "uses")
Rel(render, cfg, "uses")

Rel(ports, adapters, "implemented by")

Rel(adapters, mdit, "imports")
Rel(adapters, mrml, "imports")

Rel(render, apps, "returns HTML + text")

SHOW_LEGEND()
@enduml
